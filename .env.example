DATABASE_URL=
USE_PGLITE=true

JWT_SECRET=
JWT_ISSUER=autoerp
JWT_AUDIENCE=autoerp-users

ALLOW_MOCK_AUTH=false

# Provider and network dispatch remain disabled by default. Policy values are bounded server-side.
WHATSAPP_PROVIDER_ENABLED=false
WHATSAPP_DISPATCH_BATCH_SIZE=25
WHATSAPP_DISPATCH_RATE_LIMIT_PER_MINUTE=60
WHATSAPP_DISPATCH_MAX_ATTEMPTS=3
WHATSAPP_DISPATCH_RETRY_SECONDS=60,300,1800

# Disabled by default. JSON object mapping tenant IDs to server-only WhatsApp webhook HMAC secrets.
# Synthetic endpoint fails closed while this is empty. Never expose these values to Vite/browser code.
WHATSAPP_SYNTHETIC_WEBHOOK_KEYS_JSON=

# Disabled by default. JSON object mapping tenant IDs to server-only HMAC secrets (minimum 32 characters).
# Example shape only: {"tenant-id":"replace-with-a-generated-server-secret"}
TELEMETRY_SYNTHETIC_WEBHOOK_KEYS_JSON=

# Read-only retention eligibility window (30–3650 days). Invalid or absent values use 90 days.
# This does not delete telemetry. A destructive purge remains disabled and requires separate authorization.
TELEMETRY_RETENTION_DAYS=90

# Select SERVER_FS (default) or R2. R2 remains disabled until selected explicitly.
ATTACHMENT_STORAGE_PROVIDER=SERVER_FS
# Economic durable storage option for Render Free. Never expose these server-side secrets to the browser.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# SECURITY-2I4A: required for server-side attachment upload/download.
# Point this to durable server storage in production. No browser/in-memory fallback exists.
ATTACHMENT_STORAGE_DIR=
# Set true only after the configured directory is backed by durable storage.
# The server rejects a durable claim for known ephemeral roots such as /tmp.
ATTACHMENT_STORAGE_DURABLE=false

# DOC-AI remains fail-closed unless every server-side setting below is configured explicitly.
# Synthetic-only remains the default. Enable real documents only in an authorized environment,
# with durable server-side storage and a server-only provider key. Never expose these values to Vite/browser code.
DOC_AI_WORKER_ENABLED=false
DOC_AI_PROVIDER=GEMINI
DOC_AI_GEMINI_MODEL=gemini-3.6-flash
DOC_AI_REAL_DOCUMENTS_ENABLED=false
# Required while real-document mode is false; optional when real-document mode is explicitly true.
DOC_AI_SYNTHETIC_SHA256_ALLOWLIST=
GEMINI_API_KEY=

APP_URL="MY_APP_URL"